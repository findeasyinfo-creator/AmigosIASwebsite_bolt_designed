# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local for local development
# For Vercel deployment, set these in the Vercel dashboard
# ============================================

# API URL - Backend endpoint
# Local development
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (Railway backend)
NEXT_PUBLIC_API_URL=https://your-railway-backend.up.railway.app/api

# Site URL (for SEO and meta tags)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Vercel:
# 1. Add these variables in Project Settings → Environment Variables
# 2. NEXT_PUBLIC_API_URL should point to your Railway backend
# 3. Redeploy after changing environment variables
# ============================================
